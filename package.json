{
  "private": true,
  "author": "yafenghuang-cn <shms9061@yumchina.com>",
  "scripts": {
    "build": "pnpm build:uat",
    "build:pre": "UMI_ENV=pre max build && pnpm deadcode",
    "build:prod": "UMI_ENV=production max build && pnpm deadcode",
    "build:uat": "UMI_ENV=uat max build && pnpm deadcode",
    "deadcode": "knip --include files,exports --no-exit-code --no-config-hints",
    "dev": "UMI_ENV=dev max dev",
    "dev:pre": "UMI_ENV=pre max dev",
    "dev:prod": "UMI_ENV=production max dev",
    "dev:uat": "UMI_ENV=uat max dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "max setup",
    "lint": "pnpm lint:js && pnpm lint:style",
    "lint:fix": "pnpm lint:js --fix && pnpm lint:style --fix",
    "lint:js": "eslint . --ext .js,.jsx,.ts,.tsx,.cjs,.mjs --resolve-plugins-relative-to . --max-warnings=0",
    "lint:style": "stylelint \"**/*.{css,less}\" --allow-empty-input",
    "prepare": "husky",
    "setup": "max setup",
    "start": "pnpm dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "3.1.15-5",
